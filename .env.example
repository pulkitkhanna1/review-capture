# ── Cloud (Railway / Render) — Resend HTTP API (recommended) ──
# See RAILWAY_SETUP.md
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Pulkit <reviews@yourdomain.com>

# ── Cloud alternative — SendGrid HTTP API ──
# SENDGRID_API_KEY=SG.xxxxxxxxx
# SENDGRID_FROM=Pulkit <reviews@yourdomain.com>

# ── Local only — Gmail SMTP ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Pulkit <your@gmail.com>

PM_EMAIL=your@gmail.com
HTTP_PORT=3000

# Local + real clients: ngrok http 3000 → APP_URL=https://xxxx.ngrok-free.app

# Anthropic — optional AI drafts
# ANTHROPIC_API_KEY=sk-ant-your-key
